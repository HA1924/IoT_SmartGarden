# ============================================================
#  AquaControl Pro - biến môi trường
#  Copy file này thành .env rồi chỉnh giá trị thật.
# ============================================================

# ===== Server =====
# HOST: dev để 127.0.0.1 (chỉ máy này). Khi đẩy lên IP tĩnh/LAN đổi thành 0.0.0.0
HOST=127.0.0.1
PORT=3000
# Khi chạy production thật: production (bật cookie bảo mật, tắt log chi tiết)
NODE_ENV=development

# URL công khai của server. Dev: http://localhost:3000
# Khi lên IP tĩnh: http://203.0.113.50:3000  hoặc  https://your-domain.com
PUBLIC_URL=http://localhost:3000

# Chuỗi bí mật ký session cookie - ĐỔI sang chuỗi ngẫu nhiên dài khi production
SESSION_SECRET=doi_chuoi_bi_mat_nay_thanh_ngau_nhien
# Đặt true khi đã có HTTPS (cookie chỉ gửi qua https)
COOKIE_SECURE=false

# API key cho ESP32 / ESP32-Cam / AI-service gọi vào (header: x-api-key)
DEVICE_API_KEY=esp32-secret-key-doi-di

# ===== SQL Server =====
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_SERVER=localhost
DB_DATABASE=AquaControl
DB_PORT=1433
# Bật khi dùng SQL Server Express / local dev (self-signed cert)
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ===== AI microservice (Python/OpenCV) =====
AI_SERVICE_URL=http://localhost:5001

# ===== ESP32-Cam stream (hiển thị trên trang Camera) =====
# Dùng 3 camera quan sát, mỗi camera ứng với 1 zone.
# ESP32CAM_STREAM_URL (cũ) vẫn được dùng làm camera Zone 1 nếu không đặt _1.
ESP32CAM_STREAM_URL=http://192.168.1.144:81/stream
ESP32CAM_STREAM_URL_1=http://192.168.1.144:81/stream
ESP32CAM_STREAM_URL_2=http://192.168.1.145:81/stream
ESP32CAM_STREAM_URL_3=http://192.168.1.146:81/stream
