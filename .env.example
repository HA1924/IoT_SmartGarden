# ============================================================
#  AquaControl Pro v2 - biến môi trường
#  Copy file này thành .env rồi chỉnh giá trị thật.
# ============================================================

# ===== Server =====
# HOST: dev để 127.0.0.1 (chỉ máy này). Để ESP32/LAN truy cập được thì đổi thành 0.0.0.0
HOST=127.0.0.1
PORT=3000
# Khi chạy thật: production (bật cookie bảo mật, tắt log chi tiết)
NODE_ENV=development

# URL công khai của server. Dev: http://localhost:3000
# Khi có domain: https://your-domain.com
PUBLIC_URL=http://localhost:3000

# Chuỗi bí mật ký session cookie - ĐỔI sang chuỗi ngẫu nhiên dài khi chạy thật
SESSION_SECRET=doi_chuoi_bi_mat_nay_thanh_ngau_nhien
# Đặt true khi đã có HTTPS (cookie chỉ gửi qua https)
COOKIE_SECURE=false

# ===== API key thiết bị =====
# Mỗi node ESP32 có key RIÊNG lưu ở cột Devices.ApiKey trong database
# (xem phần seed cuối file db/schema.sql).
# Key dưới đây là KEY DỰ PHÒNG: được chấp nhận cho mọi zone, dùng cho
# `npm run simulate` và công cụ test. Đổi nó khi chạy thật.
DEVICE_API_KEY=aqcp-master-key-doi-di

# ===== SQL Server =====
DB_USER=aquacontrol
DB_PASSWORD=DatMatKhauManh@2026
# Nên bật TCP/IP + cố định cổng 1433 trong SQL Server Configuration Manager
# rồi dùng localhost, thay vì tên instance dạng localhost\SQLEXPRESS.
DB_SERVER=localhost
DB_DATABASE=AquaControl
DB_PORT=1433
# Bật khi dùng SQL Server Express / local dev (self-signed cert)
DB_ENCRYPT=false
DB_TRUST_CERT=true
